---
{
  "document": {
    "id": "service-request",
    "kind": "form",
    "locale": "es-ES",
    "revision": 1,
    "title": "Solicitud de servicio"
  },
  "fields": {
    "name": { "label": "Nombre", "maxLength": 80, "required": true, "type": "text" },
    "email": { "label": "Correo", "required": true, "type": "email" },
    "priority": {
      "label": "Prioridad",
      "options": [
        { "label": "Normal", "value": "normal" },
        { "label": "Urgente", "value": "urgent" }
      ],
      "type": "select"
    },
    "details": { "label": "Detalles", "type": "multiline" }
  },
  "format": "mdlf",
  "formatVersion": 1,
  "values": {
    "name": "Ada Lovelace",
    "email": "ada@example.com",
    "priority": "urgent",
    "details": "Necesito una revisión del informe."
  }
}
---
# Solicitud de servicio

Nombre: {{field:name}}

Correo: {{field:email}}

Prioridad: {{field:priority}}

Detalles:

{{field:details}}
