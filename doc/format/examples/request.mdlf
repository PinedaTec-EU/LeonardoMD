---
{
  "document": {
    "id": "service-request",
    "kind": "form",
    "locale": "es-ES",
    "revision": 1,
    "title": "Solicitud de servicio"
  },
  "fields": {
    "name": {
      "label": "Nombre",
      "maxLength": 80,
      "required": true,
      "type": "text"
    },
    "email": {
      "label": "Correo",
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "required": true,
      "type": "email"
    },
    "priority": {
      "label": "Prioridad",
      "options": [
        { "label": "Normal", "value": "normal" },
        { "label": "Urgente", "value": "urgent" }
      ],
      "type": "select"
    },
    "details": {
      "label": "Detalles",
      "maxLength": 2000,
      "type": "multiline"
    }
  },
  "format": "mdlf",
  "formatVersion": 1,
  "layout": {
    "background": {
      "color": "#F8F8F5",
      "image": "assets/letterhead.png",
      "opacity": 0.18
    },
    "tables": []
  },
  "values": {
    "name": null,
    "email": null,
    "priority": "normal",
    "details": null
  }
}
---
# Solicitud de servicio

Nombre: {{field:name}}

Correo: {{field:email}}

Prioridad: {{field:priority}}

Detalles:

{{field:details}}
