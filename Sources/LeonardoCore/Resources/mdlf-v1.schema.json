{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pinedatec.eu/leonardo/mdlf/v1.schema.json",
  "title": "Leonardo MDLF v1 metadata",
  "type": "object",
  "required": ["format", "formatVersion"],
  "properties": {
    "format": { "const": "mdlf" },
    "formatVersion": { "const": 1 },
    "document": { "$ref": "#/$defs/document" },
    "fields": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/field" }
    },
    "values": {
      "type": "object",
      "additionalProperties": {}
    },
    "layout": { "$ref": "#/$defs/layout" }
  },
  "additionalProperties": false,
  "$defs": {
    "document": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "kind": { "enum": ["document", "form"] },
        "revision": { "type": "integer", "minimum": 1 },
        "locale": { "type": "string" }
      },
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "required": ["value"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "label": { "type": "string" }
      },
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["text", "multiline", "number", "date", "checkbox", "select", "email", "url"] },
        "appearance": { "enum": ["checkbox", "switch"] },
        "label": { "type": "string" },
        "required": { "type": "boolean" },
        "readOnly": { "type": "boolean" },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "pattern": { "type": "string", "maxLength": 512 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "options": { "type": "array", "items": { "$ref": "#/$defs/option" } },
        "placeholder": { "type": "string" },
        "helpText": { "type": "string" },
        "validationMessage": { "type": "string" },
        "defaultValue": {}
      },
      "additionalProperties": false
    },
    "dimension": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "enum": ["points", "percent"] }
      },
      "additionalProperties": false
    },
    "position": {
      "type": "object",
      "properties": {
        "placement": { "enum": ["flow", "relative", "absolute"] },
        "x": { "$ref": "#/$defs/dimension" },
        "y": { "$ref": "#/$defs/dimension" },
        "anchor": { "enum": ["topLeading", "top", "topTrailing", "leading", "center", "trailing", "bottomLeading", "bottom", "bottomTrailing"] }
      },
      "additionalProperties": false
    },
    "size": {
      "type": "object",
      "properties": {
        "width": { "$ref": "#/$defs/dimension" },
        "height": { "$ref": "#/$defs/dimension" },
        "preserveAspectRatio": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "background": {
      "type": "object",
      "properties": {
        "color": { "type": "string" },
        "image": { "type": "string" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "fit": { "enum": ["contain", "cover", "fill", "none"] },
        "position": { "$ref": "#/$defs/position" }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "occurrence": { "type": "integer", "minimum": 1 },
        "size": { "$ref": "#/$defs/size" },
        "position": { "$ref": "#/$defs/position" },
        "fit": { "enum": ["contain", "cover", "fill", "none"] },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "column": {
      "type": "object",
      "properties": {
        "width": { "$ref": "#/$defs/dimension" },
        "minimumWidth": { "$ref": "#/$defs/dimension" },
        "maximumWidth": { "$ref": "#/$defs/dimension" }
      },
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "required": ["occurrence"],
      "properties": {
        "occurrence": { "type": "integer", "minimum": 1 },
        "width": { "$ref": "#/$defs/dimension" },
        "columns": { "type": "array", "items": { "$ref": "#/$defs/column" } },
        "repeatHeader": { "type": "boolean" },
        "allowRowBreak": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "page": { "$ref": "#/$defs/page" },
        "background": { "$ref": "#/$defs/background" },
        "images": { "type": "array", "items": { "$ref": "#/$defs/image" } },
        "tables": { "type": "array", "items": { "$ref": "#/$defs/table" } }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "size": { "enum": ["a4", "letter", "custom"] },
        "orientation": { "enum": ["portrait", "landscape"] },
        "widthPoints": { "type": "number" },
        "heightPoints": { "type": "number" },
        "margins": { "$ref": "#/$defs/margins" }
      },
      "additionalProperties": false
    },
    "margins": {
      "type": "object",
      "properties": {
        "top": { "type": "number" },
        "right": { "type": "number" },
        "bottom": { "type": "number" },
        "left": { "type": "number" }
      },
      "additionalProperties": false
    }
  }
}
